function populateWeekSelects() {
  const revSel  = document.getElementById('reviewWeekSelect');
  const quizSel = document.getElementById('quizWeekSelector');

  // Review selector — only weeks that have full REVIEW_DATA
  revSel.innerHTML = '';
  Object.keys(REVIEW_DATA).forEach(w => {
    const opt = document.createElement('option');
    opt.value = w;
    opt.textContent = REVIEW_DATA[w].label;
    if (Number(w) === 3) opt.selected = true;
    revSel.appendChild(opt);
  });

  // Quiz selector — every week that has QUIZ_DATA
  quizSel.innerHTML = '';
  Object.keys(QUIZ_DATA).forEach(w => {
    const opt = document.createElement('option');
    opt.value = w;
    opt.textContent = `Week ${w}`;
    if (Number(w) === 1) opt.selected = true;
    quizSel.appendChild(opt);
  });
}

// ═══════════════════════════════════════════
//  RENDER REVIEW
// ═══════════════════════════════════════════
function renderReview() {
  const w    = parseInt(document.getElementById('reviewWeekSelect').value);
  const data = REVIEW_DATA[w];
  document.getElementById('reviewContent').innerHTML = data.days.map((day, i) => `
<div class="review-day">
  <div class="rev-head" onclick="toggleRev(${i})">
    <h3>${day.title}</h3>
    <span class="rev-arrow" id="ra${i}">▼</span>
  </div>
  <div class="rev-body" id="rb${i}">
    ${day.passages.map(p => `
    <div class="rev-passage">
      <strong>📖 ${p.ref}</strong>
      <p>${p.s}</p>
    </div>`).join('')}
  </div>
</div>`).join('');
}

function toggleRev(i) {
  document.getElementById('rb'+i).classList.toggle('open');
  document.getElementById('ra'+i).classList.toggle('open');
}

