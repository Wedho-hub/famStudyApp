<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Family Bible Study · Roster & Journey</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,800;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Crimson+Pro:wght@300;400;600&display=swap" rel="stylesheet">
<style>
:root {
  --cream: #f5f0e8;
  --parchment: #ede4d0;
  --gold: #c9922a;
  --gold-light: #e8b84b;
  --gold-dark: #8b6218;
  --brown: #3d2810;
  --brown-mid: #6b3f1a;
  --brown-light: #9c6b3c;
  --ink: #1a1008;
  --blue: #2c4a7c;
  --green: #2d5a3d;
  --red: #8b2020;
  --purple: #3d2060;
  --shadow: rgba(61,40,16,0.18);
}
* { margin:0; padding:0; box-sizing:border-box; }
html { font-size: 106.25%; }
body {
  background: var(--cream);
  background-image:
    radial-gradient(ellipse at 20% 0%, rgba(201,146,42,0.08) 0%, transparent 60%),
    radial-gradient(ellipse at 80% 100%, rgba(44,74,124,0.06) 0%, transparent 60%);
  color: var(--ink);
  font-family: 'EB Garamond', serif;
  min-height: 100vh;
}

/* ── HEADER ── */
header {
  text-align: center;
  padding: 2.5rem 1rem 1.75rem;
  border-bottom: 2px solid var(--gold);
  background: linear-gradient(180deg, rgba(201,146,42,0.07) 0%, transparent 100%);
}
header::before {
  content: '✦ ✦ ✦';
  display: block;
  color: var(--gold);
  font-size: 0.95rem;
  letter-spacing: 0.9rem;
  margin-bottom: 0.6rem;
  opacity: 0.65;
}
header h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.8rem, 5vw, 3rem);
  font-weight: 800;
  color: var(--brown);
  line-height: 1.15;
}
header h1 span { color: var(--gold); font-style: italic; }
header p.subtitle {
  font-family: 'Crimson Pro', serif;
  color: var(--brown-light);
  font-size: 1.05rem;
  margin-top: 0.4rem;
  letter-spacing: 0.05em;
  font-weight: 300;
}
.families {
  display: flex;
  justify-content: center;
  gap: 1rem;
  margin-top: 1rem;
  flex-wrap: wrap;
}
.family-badge {
  background: var(--parchment);
  border: 1px solid rgba(201,146,42,0.4);
  border-radius: 2rem;
  padding: 0.25rem 0.9rem;
  font-size: 0.88rem;
  color: var(--brown-mid);
  font-family: 'Crimson Pro', serif;
}

/* ── NAV ── */
nav {
  display: flex;
  justify-content: center;
  gap: 0.5rem;
  padding: 1.1rem 1rem;
  flex-wrap: wrap;
  border-bottom: 1px solid rgba(201,146,42,0.2);
}
nav button {
  font-family: 'Crimson Pro', serif;
  font-size: 1rem;
  font-weight: 600;
  padding: 0.45rem 1.2rem;
  border: 1.5px solid var(--gold);
  border-radius: 0.3rem;
  background: transparent;
  color: var(--brown-mid);
  cursor: pointer;
  transition: all 0.2s;
  letter-spacing: 0.03em;
}
nav button:hover { background: rgba(201,146,42,0.1); }
nav button.active { background: var(--gold); color: white; border-color: var(--gold); }

/* ── MAIN ── */
main { max-width: 960px; margin: 0 auto; padding: 2rem 1rem 4rem; }
section { display: none; }
section.active { display: block; }

/* ── SECTION HEADINGS ── */
.progress-section h2,
.quiz-section h2,
.review-section h2 {
  font-family: 'Playfair Display', serif;
  font-size: 1.55rem;
  color: var(--brown);
  margin-bottom: 1.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid var(--gold);
}

/* ── WEEK CONTROLS ── */
.week-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.65rem;
  margin-bottom: 1.75rem;
  flex-wrap: wrap;
}
.wk-arrow {
  width: 2.3rem; height: 2.3rem;
  border-radius: 50%;
  border: 1.5px solid var(--gold);
  background: transparent;
  color: var(--gold-dark);
  font-size: 1.15rem;
  cursor: pointer;
  transition: all 0.2s;
  display: flex; align-items: center; justify-content: center;
}
.wk-arrow:hover { background: var(--gold); color: white; }
.week-label {
  font-family: 'Playfair Display', serif;
  font-size: 1rem;
  color: var(--brown);
  font-weight: 600;
  min-width: 230px;
  text-align: center;
}
.today-jump {
  padding: 0.3rem 0.85rem;
  border: 1.5px solid var(--gold);
  border-radius: 2rem;
  background: transparent;
  color: var(--gold-dark);
  font-family: 'Crimson Pro', serif;
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  letter-spacing: 0.04em;
}
.today-jump:hover { background: var(--gold); color: white; }

/* ── ROSTER GRID ── */
.roster-grid { display: grid; gap: 1rem; }

/* ── DAY CARD ── */
.day-card {
  background: white;
  border: 1px solid rgba(201,146,42,0.25);
  border-radius: 0.6rem;
  overflow: hidden;
  box-shadow: 0 2px 8px var(--shadow);
  transition: box-shadow 0.2s;
}
.day-card:hover { box-shadow: 0 4px 16px var(--shadow); }
.day-card.sabbath {
  border-color: var(--purple);
  background: linear-gradient(135deg, #f9f5ff 0%, white 60%);
}
.day-card.today {
  border-color: var(--gold);
  border-width: 2px;
  box-shadow: 0 0 0 3px rgba(201,146,42,0.15), 0 4px 18px var(--shadow);
}
.day-card.past { opacity: 0.68; }

/* card header */
.card-head {
  padding: 0.65rem 1rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  flex-wrap: wrap;
  background: var(--parchment);
  border-bottom: 1px solid rgba(201,146,42,0.15);
}
.day-card.sabbath .card-head {
  background: linear-gradient(90deg, #3d2060 0%, #6040a0 100%);
}
.head-left { display: flex; flex-direction: column; gap: 0.05rem; }
.day-name {
  font-family: 'Playfair Display', serif;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--brown);
}
.day-card.sabbath .day-name { color: white; }
.day-date {
  font-family: 'Crimson Pro', serif;
  font-size: 0.78rem;
  color: var(--brown-light);
}
.day-card.sabbath .day-date { color: rgba(255,255,255,0.65); }
.head-right {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.led-by {
  font-family: 'Crimson Pro', serif;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--brown-light);
}
.day-card.sabbath .led-by { color: rgba(255,255,255,0.6); }
.presenter {
  font-family: 'Crimson Pro', serif;
  font-size: 1rem;
  font-weight: 700;
  color: var(--brown-mid);
}
.day-card.sabbath .presenter { color: white; }
.today-badge {
  background: var(--gold);
  color: white;
  font-size: 0.67rem;
  padding: 0.12rem 0.5rem;
  border-radius: 1rem;
  font-family: 'Crimson Pro', serif;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.day-card.sabbath .today-badge { background: white; color: var(--purple); }

/* card body */
.card-body { display: flex; flex-direction: column; }
.readings-block {
  padding: 0.7rem 1rem 0.55rem;
  border-bottom: 1px solid rgba(201,146,42,0.1);
}
.teach-block {
  padding: 0.55rem 1rem 0.7rem;
  background: rgba(61,32,96,0.03);
}
.day-card.sabbath .teach-block { background: rgba(61,32,96,0.05); }

.block-label {
  font-family: 'Crimson Pro', serif;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: var(--brown-light);
  margin-bottom: 0.4rem;
}
.r-row {
  display: flex;
  align-items: baseline;
  gap: 0.4rem;
  padding: 0.18rem 0;
  font-family: 'Crimson Pro', serif;
  font-size: 0.97rem;
  line-height: 1.4;
}
.r-ref { font-weight: 600; }
.r-tag {
  font-size: 0.68rem;
  padding: 0.04rem 0.38rem;
  border-radius: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  white-space: nowrap;
}
.ot  { color: var(--brown-mid); }
.ot  .r-tag { background: rgba(139,98,24,0.12); color: var(--brown-mid); }
.ps  { color: var(--blue); }
.ps  .r-tag { background: rgba(44,74,124,0.1); color: var(--blue); }
.pr  { color: var(--green); }
.pr  .r-tag { background: rgba(45,90,61,0.1); color: var(--green); }
.nt  { color: var(--red); }
.nt  .r-tag { background: rgba(139,32,32,0.1); color: var(--red); }
.prop { color: var(--brown); }
.prop .r-tag { background: rgba(61,40,16,0.1); color: var(--brown); }
.tch  { color: var(--purple); }
.tch  .r-tag { background: rgba(61,32,96,0.1); color: var(--purple); }

/* ── PROGRESS ── */
.progress-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  gap: 1rem;
  margin-bottom: 2rem;
}
.progress-card {
  background: white;
  border: 1px solid rgba(201,146,42,0.2);
  border-radius: 0.6rem;
  padding: 1.1rem;
  box-shadow: 0 1px 4px var(--shadow);
}
.progress-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1rem;
  color: var(--brown);
  margin-bottom: 0.6rem;
}
.prog-bar-wrap {
  background: var(--parchment);
  border-radius: 1rem;
  height: 8px;
  overflow: hidden;
  margin-bottom: 0.4rem;
}
.prog-bar {
  height: 100%;
  border-radius: 1rem;
  background: linear-gradient(90deg, var(--gold-dark), var(--gold-light));
  transition: width 0.6s;
}
.prog-label { font-size: 0.8rem; color: var(--brown-light); font-family: 'Crimson Pro', serif; }

/* ── REVIEW ── */
.review-day {
  background: white;
  border: 1px solid rgba(201,146,42,0.2);
  border-radius: 0.6rem;
  margin-bottom: 1rem;
  overflow: hidden;
  box-shadow: 0 1px 4px var(--shadow);
}
.rev-head {
  padding: 0.7rem 1rem;
  background: var(--parchment);
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  border-bottom: 1px solid rgba(201,146,42,0.15);
}
.rev-head h3 {
  font-family: 'Playfair Display', serif;
  font-size: 0.97rem;
  color: var(--brown);
}
.rev-arrow { color: var(--gold); font-size: 1.1rem; transition: transform 0.2s; }
.rev-arrow.open { transform: rotate(180deg); }
.rev-body {
  padding: 0 1rem;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.35s;
}
.rev-body.open { max-height: 700px; padding: 1rem; }
.rev-passage { margin-bottom: 0.75rem; }
.rev-passage strong {
  font-family: 'Playfair Display', serif;
  color: var(--gold-dark);
  font-size: 0.88rem;
  display: block;
  margin-bottom: 0.2rem;
}
.rev-passage p { font-size: 0.91rem; color: var(--brown-mid); line-height: 1.6; }
.week-select-wrap {
  margin-bottom: 1.4rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}
.week-select-wrap label { font-family: 'Playfair Display', serif; color: var(--brown); }
.week-select-wrap select,
.quiz-week-wrap select {
  padding: 0.45rem 0.9rem;
  border: 1.5px solid var(--gold);
  border-radius: 0.3rem;
  background: white;
  color: var(--brown);
  font-family: 'Crimson Pro', serif;
  font-size: 1rem;
}

/* ── QUIZ ── */
.quiz-week-wrap {
  margin-bottom: 1.2rem;
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  align-items: center;
}
.quiz-week-wrap label { font-family: 'Playfair Display', serif; color: var(--brown); }
.quiz-card {
  background: white;
  border: 1px solid rgba(201,146,42,0.25);
  border-radius: 0.6rem;
  padding: 1.4rem;
  margin-bottom: 1rem;
  box-shadow: 0 2px 8px var(--shadow);
}
.quiz-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.1rem;
  color: var(--brown);
  margin-bottom: 1rem;
  line-height: 1.4;
}
.quiz-options { display: flex; flex-direction: column; gap: 0.45rem; }
.quiz-opt {
  padding: 0.55rem 1rem;
  border: 1.5px solid rgba(201,146,42,0.3);
  border-radius: 0.4rem;
  background: var(--parchment);
  cursor: pointer;
  font-family: 'Crimson Pro', serif;
  font-size: 0.95rem;
  color: var(--brown);
  transition: all 0.2s;
  text-align: left;
}
.quiz-opt:hover { border-color: var(--gold); background: rgba(201,146,42,0.08); }
.quiz-opt.correct { background: rgba(45,90,61,0.15); border-color: var(--green); color: var(--green); }
.quiz-opt.wrong   { background: rgba(139,32,32,0.1); border-color: var(--red); color: var(--red); }
.quiz-opt.revealed { opacity: 0.65; cursor: default; pointer-events: none; }
.quiz-opt.correct-reveal { background: rgba(45,90,61,0.12); border-color: var(--green); color: var(--green); }
.quiz-exp {
  margin-top: 0.7rem;
  padding: 0.55rem 0.8rem;
  background: rgba(201,146,42,0.08);
  border-left: 3px solid var(--gold);
  border-radius: 0 0.3rem 0.3rem 0;
  font-size: 0.89rem;
  color: var(--brown-mid);
  font-family: 'Crimson Pro', serif;
  display: none;
}
.quiz-exp.show { display: block; }
.quiz-score {
  font-family: 'Playfair Display', serif;
  font-size: 1.4rem;
  color: var(--brown);
  text-align: center;
  margin: 1.5rem 0 0.5rem;
}
.quiz-score span { color: var(--gold); }
.btn-primary {
  display: block;
  margin: 1rem auto 0;
  padding: 0.6rem 2rem;
  background: var(--gold);
  color: white;
  border: none;
  border-radius: 0.4rem;
  font-family: 'Playfair Display', serif;
  font-size: 1rem;
  cursor: pointer;
  transition: background 0.2s;
}
.btn-primary:hover { background: var(--gold-dark); }
.quiz-score-area { display: none; }

.complete-row {
  padding: 0.75rem 1rem 0.25rem;
}
.complete-toggle {
  display: inline-flex;
  gap: 0.5rem;
  align-items: center;
  font-family: 'Crimson Pro', serif;
  color: var(--brown);
  font-size: 0.92rem;
}
.complete-toggle input {
  width: 1rem;
  height: 1rem;
  accent-color: var(--gold);
}
.note-block {
  padding: 0 1rem 1rem;
}
.note-block label {
  display: block;
  margin-bottom: 0.4rem;
  font-family: 'Crimson Pro', serif;
  color: var(--brown);
  font-size: 0.88rem;
}
.note-block textarea {
  width: 100%;
  min-height: 6rem;
  border: 1px solid rgba(201,146,42,0.25);
  border-radius: 0.45rem;
  padding: 0.75rem 0.85rem;
  font-family: 'Crimson Pro', serif;
  font-size: 0.95rem;
  color: var(--brown-dark);
  resize: vertical;
}
.note-block textarea:focus {
  outline: 2px solid rgba(201,146,42,0.35);
}
.day-card.completed {
  border-color: rgba(45,90,61,0.4);
}

/* ── FOOTER ── */
footer {
  text-align: center;
  padding: 1.5rem;
  border-top: 1px solid rgba(201,146,42,0.2);
  font-family: 'Crimson Pro', serif;
  color: var(--brown-light);
  font-size: 0.9rem;
}
footer strong { color: var(--gold-dark); }

@media(max-width:580px){
  .card-head { flex-direction: column; align-items: flex-start; }
  .week-label { min-width: 160px; font-size: 0.88rem; }
}
</style>
</head>
<body>

<header>
  <h1>📖 <span>Family</span> Bible Study</h1>
  <p class="subtitle">Roster · Progress · Review · Quizzes</p>
  <div class="families">
    <span class="family-badge">👵🏾 Makhulu</span>
    <span class="family-badge">👩🏾 Miranda</span>
    <span class="family-badge">👨🏾 Lunathi</span>
    <span class="family-badge">👨🏾‍💻 Wedho</span>
  </div>
</header>

<nav>
  <button type="button" class="active" onclick="showTab('roster',this)">📋 Roster</button>
  <button type="button" onclick="showTab('progress',this)">📊 Progress</button>
  <button type="button" onclick="showTab('review',this)">🔁 Review</button>
  <button type="button" onclick="showTab('quiz',this)">❓ Quiz</button>
</nav>

<main>

  <!-- ROSTER -->
  <section id="roster" class="active">
    <div class="week-controls">
      <button type="button" class="wk-arrow" onclick="changeWeek(-1)">‹</button>
      <div class="week-label" id="weekLabel"></div>
      <button type="button" class="wk-arrow" onclick="changeWeek(1)">›</button>
      <button type="button" class="today-jump" onclick="jumpToToday()">↩ Today</button>
    </div>
    <div class="roster-grid" id="rosterGrid"></div>
  </section>

  <!-- PROGRESS -->
  <section id="progress" class="progress-section">
    <h2>📖 Bible Journey Progress</h2>
    <div class="progress-grid" id="progressGrid"></div>
  </section>

  <!-- REVIEW -->
  <section id="review" class="review-section">
    <h2>🔁 Weekly Review</h2>
    <div class="week-select-wrap">
      <label>Review week:</label>
      <select id="reviewWeekSelect" onchange="renderReview()"></select>
    </div>
    <div id="reviewContent"></div>
  </section>

  <!-- QUIZ -->
  <section id="quiz" class="quiz-section">
    <h2>❓ Memory Quiz</h2>
    <div class="quiz-week-wrap">
      <label>Quiz on week:</label>
      <select id="quizWeekSelector" onchange="renderQuiz()"></select>
    </div>
    <div id="quizContent"></div>
    <div id="quizScoreArea" class="quiz-score-area">
      <div class="quiz-score">Score: <span id="scoreText"></span></div>
      <button type="button" class="btn-primary" onclick="resetQuiz()">Try Again</button>
    </div>
  </section>

</main>

<footer>
  <p><strong>Finishing the Whole Bible — Together.</strong><br>Stay consistent, engaged, and growing spiritually. 🙏🏾</p>
</footer>

<script>
// ═══════════════════════════════════════════
//  DATA
// ═══════════════════════════════════════════
const NT_BOOKS = [
  {name:'Matthew',chs:28},{name:'Mark',chs:16},{name:'Luke',chs:24},
  {name:'John',chs:21},{name:'Acts',chs:28},{name:'Romans',chs:16},
  {name:'1 Corinthians',chs:16},{name:'2 Corinthians',chs:13},
  {name:'Galatians',chs:6},{name:'Ephesians',chs:6},
  {name:'Philippians',chs:4},{name:'Colossians',chs:4},
  {name:'1 Thessalonians',chs:5},{name:'2 Thessalonians',chs:3},
  {name:'1 Timothy',chs:6},{name:'2 Timothy',chs:4},
  {name:'Titus',chs:3},{name:'Philemon',chs:1},{name:'Hebrews',chs:13},
  {name:'James',chs:5},{name:'1 Peter',chs:5},{name:'2 Peter',chs:3},
  {name:'1 John',chs:5},{name:'2 John',chs:1},{name:'3 John',chs:1},
  {name:'Jude',chs:1},{name:'Revelation',chs:22},
];
const OT_BOOKS = [
  {name:'Genesis',chs:50},{name:'Exodus',chs:40},{name:'Leviticus',chs:27},
  {name:'Numbers',chs:36},{name:'Deuteronomy',chs:34},{name:'Joshua',chs:24},
  {name:'Judges',chs:21},{name:'Ruth',chs:4},{name:'1 Samuel',chs:31},
  {name:'2 Samuel',chs:24},{name:'1 Kings',chs:22},{name:'2 Kings',chs:25},
  {name:'1 Chronicles',chs:29},{name:'2 Chronicles',chs:36},{name:'Ezra',chs:10},
  {name:'Nehemiah',chs:13},{name:'Esther',chs:10},{name:'Job',chs:42},
  {name:'Psalms',chs:150},{name:'Proverbs',chs:31},
  {name:'Ecclesiastes',chs:12},{name:'Song of Solomon',chs:8},
  {name:'Isaiah',chs:66},{name:'Jeremiah',chs:52},{name:'Lamentations',chs:5},
  {name:'Ezekiel',chs:48},{name:'Daniel',chs:12},
];
const MAJOR_PROPHETS = [
  {name:'Isaiah',chs:66},{name:'Jeremiah',chs:52},{name:'Lamentations',chs:5},
  {name:'Ezekiel',chs:48},{name:'Daniel',chs:12},
];
const MINOR_PROPHETS = [
  {name:'Hosea',chs:14},{name:'Joel',chs:3},{name:'Amos',chs:9},
  {name:'Obadiah',chs:1},{name:'Jonah',chs:4},{name:'Micah',chs:7},
  {name:'Nahum',chs:3},{name:'Habakkuk',chs:3},{name:'Zephaniah',chs:3},
  {name:'Haggai',chs:2},{name:'Zechariah',chs:14},{name:'Malachi',chs:4},
];

// Sun/Tue/Thu wisdom track: Psalms → Job → Proverbs (cycling)
const PSALM_TRACK = [
  {name:'Psalms',chs:150},{name:'Job',chs:42},{name:'Proverbs',chs:31},
];
// Mon/Wed/Fri wisdom track: Proverbs → Ecclesiastes → Song of Solomon → Psalms (cycling)
const PROVERBS_TRACK = [
  {name:'Proverbs',chs:31},{name:'Ecclesiastes',chs:12},
  {name:'Song of Solomon',chs:8},{name:'Psalms',chs:150},
];

// Week 1 Sun=Makhulu Mon=Miranda Tue=Lunathi Wed=Makhulu Thu=Miranda Fri=Lunathi
// Week 2 Sun=Miranda  Mon=Lunathi Tue=Makhulu Wed=Miranda  Thu=Lunathi Fri=Makhulu
// Week 3 Sun=Lunathi  Mon=Makhulu Tue=Miranda Wed=Lunathi  Thu=Makhulu Fri=Miranda
const WEEKDAY_ROTATION = [
  ['👵🏾 Makhulu','👩🏾 Miranda','👨🏾 Lunathi','👵🏾 Makhulu','👩🏾 Miranda','👨🏾 Lunathi'],
  ['👩🏾 Miranda','👨🏾 Lunathi','👵🏾 Makhulu','👩🏾 Miranda','👨🏾 Lunathi','👵🏾 Makhulu'],
  ['👨🏾 Lunathi','👵🏾 Makhulu','👩🏾 Miranda','👨🏾 Lunathi','👵🏾 Makhulu','👩🏾 Miranda'],
];

// Sun=P&P  Mon=FB#  Tue=FAQs  Wed=P&P  Thu=FAQs  Fri=Sabbath School Guide
const WEDHO_SLOTS = [
  '📘 Patriarchs & Prophets',
  '📙 Fundamental Belief #',
  '❓ Bible FAQs',
  '📘 Patriarchs & Prophets',
  '❓ Bible FAQs',
  '📗 Sabbath School Study Guide',
];

const DAY_NAMES  = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Sabbath'];
const DAY_ICONS  = ['☀️','🌙','🌟','🌿','⚡','🕊️','🌅'];

// ═══════════════════════════════════════════
//  PATTERN ENGINE
// ═══════════════════════════════════════════
function resolveSeq(books, idx0) {
  let i = idx0;
  for (const b of books) {
    if (i < b.chs) return `${b.name} ${i + 1}`;
    i -= b.chs;
  }
  return books[books.length - 1].name + ' (Complete!)';
}

// Week 1 Day 0 = Gen 25 = OT flat index 24
function getOT(w, d) { return resolveSeq(OT_BOOKS, 24 + (w-1)*6 + d); }

// Week 1 Day 0 = Matt 25 = NT flat index 24
function getNT(w, d) { return resolveSeq(NT_BOOKS, 24 + (w-1)*6 + d); }

// Sun/Tue/Thu → Psalm track | Mon/Wed/Fri → Proverbs track, both starting ch 13 in week 1
function getPP(w, d) {
  const idx = 12 + Math.floor(d/2) + (w-1)*3;
  function bookTag(label) {
    if (label.startsWith('Song')) return 'Song of Sol.';
    return label.split(' ')[0];
  }
  if (d % 2 === 0) {
    const label = resolveSeq(PSALM_TRACK, idx);
    return {type:'ps', label, tag: bookTag(label)};
  } else {
    const label = resolveSeq(PROVERBS_TRACK, idx);
    return {type:'pr', label, tag: bookTag(label)};
  }
}

// Sabbath: Isaiah + Hosea, +1 chapter each week from ch 4
function getSabbathProphets(w) {
  return {
    major: resolveSeq(MAJOR_PROPHETS, 3 + (w-1)),
    minor: resolveSeq(MINOR_PROPHETS, 3 + (w-1)),
  };
}

// FB starts at #14, wraps at 28
function getFB(w) {
  const n = 14 + (w-1);
  return n <= 28 ? n : ((n-1) % 28) + 1;
}

function buildWeek(w) {
  const rot = (w-1) % 3;
  const days = [];
  for (let d = 0; d < 6; d++) {
    const slot = WEDHO_SLOTS[d] + (d === 1 ? getFB(w) : '');
    days.push({
      name: DAY_NAMES[d], icon: DAY_ICONS[d],
      presenter: WEEKDAY_ROTATION[rot][d],
      ot: getOT(w,d), nt: getNT(w,d), pp: getPP(w,d),
      wedho: slot,
    });
  }
  const sab = getSabbathProphets(w);
  days.push({
    name:'Sabbath', icon:'🌅', presenter:'👨🏾‍💻 Wedho',
    isSabbath:true, major: sab.major, minor: sab.minor,
  });
  return days;
}

// ═══════════════════════════════════════════
//  DATE HELPERS
// ═══════════════════════════════════════════
const WEEK1_START = new Date('2026-04-26T00:00:00');

function getTodayInfo() {
  const now = new Date(); now.setHours(0,0,0,0);
  const diff = Math.round((now - WEEK1_START) / 86400000);
  if (diff < 0) return {weekNum:1, dayOfWeek:0};
  return {weekNum: Math.floor(diff/7)+1, dayOfWeek: diff%7};
}

function cardDate(weekNum, dayIdx) {
  const d = new Date(WEEK1_START);
  d.setDate(d.getDate() + (weekNum-1)*7 + dayIdx);
  return d.toLocaleDateString('en-GB', {weekday:'short', day:'numeric', month:'short'});
}

function weekRange(weekNum) {
  const s = new Date(WEEK1_START);
  s.setDate(s.getDate() + (weekNum-1)*7);
  const e = new Date(s); e.setDate(e.getDate()+6);
  const o = {day:'numeric', month:'short'};
  return `${s.toLocaleDateString('en-GB',o)} – ${e.toLocaleDateString('en-GB',o)}`;
}

const {weekNum: CURRENT_WEEK} = getTodayInfo();
let displayWeek = CURRENT_WEEK;

// ═══════════════════════════════════════════
//  RENDER ROSTER
// ═══════════════════════════════════════════
function renderRoster() {
  const {weekNum: tw, dayOfWeek: td} = getTodayInfo();
  document.getElementById('weekLabel').textContent =
    `Week ${displayWeek} · ${weekRange(displayWeek)}`;

  const days = buildWeek(displayWeek);

  document.getElementById('rosterGrid').innerHTML = days.map((day, i) => {
    const isToday = displayWeek === tw && i === td;
    const isPast  = displayWeek < tw || (displayWeek === tw && i < td);
    const isSab   = !!day.isSabbath;
    const dt      = cardDate(displayWeek, i);

    // ── readings rows ──
    let rHTML = '';
    if (!isSab) {
      rHTML += row('ot',  '📖', day.ot,  'OT');
      if (day.pp) {
        if (day.pp.type === 'ps') rHTML += row('ps','🎵', day.pp.label, day.pp.tag);
        else                       rHTML += row('pr','💡', day.pp.label, day.pp.tag);
      }
      rHTML += row('nt', '✝️', day.nt, 'NT');
    } else {
      rHTML += row('prop','📖', day.major, 'Major Prophet');
      rHTML += row('prop','📖', day.minor, 'Minor Prophet');
    }

    // ── teaching row ──
    const teachLabel = isSab
      ? '🙌🏾 Reflection &amp; Discussion'
      : `🎓 Teaching &nbsp;·&nbsp; 👨🏾‍💻 Wedho`;
    const teachRow = isSab
      ? ''
      : `<div class="r-row tch"><span class="r-ref">${day.wedho}</span></div>`;

    return `<div class="day-card${isSab?' sabbath':''}${isToday?' today':''}${isPast&&!isToday?' past':''}">
  <div class="card-head">
    <div class="head-left">
      <span class="day-name">${day.icon} ${day.name}</span>
      <span class="day-date">${dt}</span>
    </div>
    <div class="head-right">
      <span class="led-by">Led by</span>
      <span class="presenter">${day.presenter}</span>
      ${isToday ? '<span class="today-badge">Today</span>' : ''}
    </div>
  </div>
  <div class="card-body">
    <div class="readings-block">
      <div class="block-label">${isSab ? '📚 Prophets' : '📚 Bible Readings'}</div>
      ${rHTML}
    </div>
    <div class="teach-block">
      <div class="block-label">${teachLabel}</div>
      ${teachRow}
    </div>
  </div>
</div>`;
  }).join('');
}

function row(cls, icon, ref, tag) {
  return `<div class="r-row ${cls}"><span>${icon}</span><span class="r-ref">${ref}</span><span class="r-tag">${tag}</span></div>`;
}

function changeWeek(delta) {
  displayWeek = Math.max(1, displayWeek + delta);
  renderRoster();
}
function jumpToToday() {
  displayWeek = getTodayInfo().weekNum;
  renderRoster();
}

// ═══════════════════════════════════════════
//  PROGRESS
// ═══════════════════════════════════════════
function renderProgress() {
  const {weekNum, dayOfWeek} = getTodayInfo();
  const doneWeeks = weekNum - 1;
  const doneDays  = doneWeeks * 6 + Math.min(dayOfWeek, 6);

  // Psalm days in current week so far: Sun(0), Tue(2), Thu(4)
  const psThisWeek = [0,2,4].filter(d => d < dayOfWeek).length;
  const psCount    = doneWeeks * 3 + psThisWeek;

  // Proverbs days: Mon(1), Wed(3), Fri(5)
  const prThisWeek = [1,3,5].filter(d => d < dayOfWeek).length;
  const prCount    = doneWeeks * 3 + prThisWeek;

  const sabbaths   = doneWeeks + (dayOfWeek === 6 ? 1 : 0);
  const totalNT    = NT_BOOKS.reduce((s,b)=>s+b.chs,0);
  const totalOT    = OT_BOOKS.reduce((s,b)=>s+b.chs,0);

  // OT: started at Gen 25 (flat 24), doneDays chapters read
  const otDone     = doneDays;
  const genesisMax = 26; // Gen 25-50 = 26 chapters
  const genDone    = Math.min(otDone, genesisMax);

  const items = [
    { name:'Genesis',             read: genDone,  total: genesisMax, desc:`Ch. 25–${24+genDone} of 50` },
    { name:'New Testament',       read: doneDays, total: totalNT,    desc:`${doneDays} of ${totalNT} chapters` },
    { name:'Psalms',              read: psCount,  total: 138,        desc:`Ps 13–${12+psCount} of 150` },
    { name:'Proverbs',            read: prCount,  total: 19,         desc:`Pr 13–${12+prCount} of 31` },
    { name:'Isaiah (Sabbaths)',   read: sabbaths, total: 63,         desc:`Ch. 4–${3+sabbaths} of 66` },
    { name:'Hosea (Sabbaths)',    read: sabbaths, total: 11,         desc:`Ch. 4–${3+sabbaths} of 14` },
    { name:'Old Testament (total)', read: otDone, total: totalOT,   desc:`${otDone} of ${totalOT} chapters` },
    { name:'Weeks Completed',     read: doneWeeks, total: Math.ceil(totalNT/6), desc:`${doneWeeks} weeks done` },
  ];

  document.getElementById('progressGrid').innerHTML = items.map(item => {
    const pct = Math.min(100, Math.round(item.read / item.total * 100));
    return `<div class="progress-card">
  <h3>${item.name}</h3>
  <div class="prog-bar-wrap"><div class="prog-bar" style="width:${pct}%"></div></div>
  <div class="prog-label">${item.desc} &nbsp;·&nbsp; ${pct}%</div>
</div>`;
  }).join('');
}

